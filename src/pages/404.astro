---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="This page doesn't exist.">
  <section class="nf">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="nf__title">This page doesn't exist.</h1>
      <p class="lead nf__body">
        The link may be out of date, or the page may have moved.
      </p>
      <div class="nf__actions">
        <a class="btn" href="/">Back to home</a>
        <a class="btn btn--ghost" href="/#work">Selected work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-top: clamp(5rem, 14vw, 11rem);
    padding-bottom: clamp(6rem, 16vw, 13rem);
  }
  .nf__title {
    margin-top: 1rem;
    font-size: var(--t-h1);
    letter-spacing: var(--ls-display);
    line-height: var(--lh-tight);
  }
  .nf__body { margin-top: 1.5rem; max-width: 34rem; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }
</style>
