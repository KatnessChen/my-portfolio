---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  isHome?: boolean;
}

const {
  title,
  description = profile.bioShort,
  ogImage = '/og-default.png',
  isHome = false,
} = Astro.props;

const siteName = `${profile.name} — ${profile.role.replace(/\.$/, '')}`;
const pageTitle = title ? `${title} — ${profile.name}` : siteName;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogUrl = new URL(ogImage, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.alias,
  jobTitle: 'Software Engineer',
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Ottawa', addressCountry: 'CA' },
  url: Astro.site?.toString(),
  sameAs: [profile.linkedin, profile.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {isHome && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(personSchema)}
      />
    )}
  </head>

  <body>
    <!-- Nebula Background -->
    <div class="nebula-bg-container" aria-hidden="true">
      <div class="nebula-blob nebula-1"></div>
      <div class="nebula-blob nebula-2"></div>
      <div class="nebula-blob nebula-3"></div>
    </div>

    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const els = document.querySelectorAll('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }

      // Parallax scrolling + mouse movement for nebula background layers
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const n1 = document.querySelector('.nebula-1') as HTMLElement;
        const n2 = document.querySelector('.nebula-2') as HTMLElement;
        const n3 = document.querySelector('.nebula-3') as HTMLElement;

        let mouseX = 0;
        let mouseY = 0;
        let scrolled = 0;

        const updateTransform = () => {
          if (n1) n1.style.transform = `translate3d(${mouseX * 0.02}px, ${scrolled * 0.1 + mouseY * 0.02}px, 0)`;
          if (n2) n2.style.transform = `translate3d(${mouseX * -0.015}px, ${scrolled * -0.05 + mouseY * -0.015}px, 0)`;
          if (n3) n3.style.transform = `translate3d(${mouseX * 0.025}px, ${scrolled * 0.08 + mouseY * 0.025}px, 0)`;
        };

        window.addEventListener('scroll', () => {
          scrolled = window.pageYOffset;
          updateTransform();
        }, { passive: true });

        window.addEventListener('mousemove', (e) => {
          const centerX = window.innerWidth / 2;
          const centerY = window.innerHeight / 2;
          mouseX = e.clientX - centerX;
          mouseY = e.clientY - centerY;
          updateTransform();
        }, { passive: true });
      }
    </script>
  </body>
</html>
